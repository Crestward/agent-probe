# Copy to `.env` and fill in the keys for the providers you intend to run.
# Only the default provider's key is required; the others are needed only when selected.

# Required for the default provider (Anthropic / Claude)
ANTHROPIC_API_KEY=

# Optional — needed only when running --provider openai
OPENAI_API_KEY=

# Optional — needed only when running --provider deepseek (OpenAI-compatible endpoint)
DEEPSEEK_API_KEY=

# Optional overrides
AGENT_PROBE_DEFAULT_PROVIDER=anthropic
# AGENT_PROBE_ANTHROPIC_MODEL=claude-opus-5-5   # or claude-sonnet-5-5 / claude-haiku-4-5 for cheaper high-volume runs
# AGENT_PROBE_OPENAI_MODEL=gpt-4.1
# AGENT_PROBE_DEEPSEEK_MODEL=deepseek-chat
# AGENT_PROBE_LOG_LEVEL=INFO
